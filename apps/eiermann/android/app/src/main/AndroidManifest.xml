<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app is a PocketBase client: without this a RELEASE build has no
         network at all. It is deliberately absent from the Flutter template's
         main manifest — src/debug and src/profile declare it for the tool's own
         hot-reload channel, which is why leaving it out here fails only in the
         one build a user ever installs. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- "In meiner Nähe" on the map: the camera jumps to the reader's position
         so they can see which buildings are around them. COARSE as well as
         FINE, and both are optional at runtime — the map works without a
         position, and the button says which refusal it hit rather than
         insisting. Declared here because a runtime request for an undeclared
         permission is refused by Android without a dialog, which would look
         exactly like a user who said no. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- The server is the only source of truth: everything a screen shows is a
         PocketBase read, and the only things on disk are the auth token
         (flutter_secure_storage), shared_preferences and the image cache. Auto
         Backup and device transfer would copy all three onto a device that never
         authenticated, outside PocketBase's access control — and the token's
         encryption key lives in the Android Keystore, which is NOT part of the
         backup, so what arrives is undecryptable anyway. Nothing is lost by
         switching it off: a fresh install re-fetches everything at login. -->
    <application
        android:label="Eiermann"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Where an identity provider redirects back to after sign-in
             (flutter_web_auth_2). On a phone the app uses the code-exchange
             flow, because PocketBase's realtime channel — which the all-in-one
             flow completes over — is dropped the moment Android backgrounds
             the app for the browser. A deep link arrives either way.

             Pinned to host "oauth-callback" so a later eiermann:// link for
             something else cannot swallow these URLs, or the other way round.
             The same URI must be registered as an allowed redirect with the
             provider; see the OAuth2 block in .env.example. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="eiermann" android:host="oauth-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
